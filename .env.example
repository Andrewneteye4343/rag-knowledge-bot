# 複製此檔為 .env 並填入你的設定
# Google AI Studio 申請: https://aistudio.google.com/apikey

GEMINI_API_KEY=你的金鑰放這裡

# 使用的 Gemini 模型（新帳號請用 gemini-3.6-flash；gemini-2.5-flash 已不對新使用者開放）
LLM_MODEL=gemini-3.6-flash

# gemini = 正式呼叫 API；mock = 不呼叫 API（測試用，會回傳範本答案）
LLM_BACKEND=gemini

# 本地 embedding 模型（中英雙語：multilingual-e5-large，第一次執行下載約 2.2GB）
# 輕量替代：sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2（0.2GB）
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# 模型快取目錄（通常不需要改；掛載到本機 ./cache 避免重複下載）
# CACHE_DIR=/app/cache

# OCR 語言（掃描型 PDF 用；chi_tra = 繁體中文, eng = 英文）
# OCR_LANG=chi_tra+eng

# 文件切塊參數（字元數）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 每次檢索回傳幾個區塊（最終給 LLM 的數量）
TOP_K=4

# --- Reranker 二階段檢索 ---
# 第一階段「海選」候選數量；設成 <= TOP_K 即停用 rerank
RERANK_TOP_K=20
# 多語言 reranker（第一次使用下載約 1.1GB）；輕量替代：Xenova/ms-marco-MiniLM-L-6-v2（僅英文）
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
