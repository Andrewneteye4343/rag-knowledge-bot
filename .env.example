# 複製此檔為 .env 並填入你的設定
# Google AI Studio 申請: https://aistudio.google.com/apikey

GEMINI_API_KEY=你的金鑰放這裡

# 使用的 Gemini 模型（免費額度可用 gemini-2.5-flash）
LLM_MODEL=gemini-2.5-flash

# gemini = 正式呼叫 API；mock = 不呼叫 API（測試用，會回傳範本答案）
LLM_BACKEND=gemini

# 本地 embedding 模型（第一次執行會自動下載，約 100MB）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 文件切塊參數（字元數）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 每次檢索回傳幾個區塊
TOP_K=4
